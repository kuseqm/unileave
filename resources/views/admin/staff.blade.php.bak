<script>
function resetPassword(id, name) {
    if(confirm('Reset password for ' + name + '? Temporary password will be: Temp@123')) {
        window.location.href = '/admin/staff/' + id + '/reset-password';
    }
}

function confirmDelete(id, name) {
    if(confirm('Delete ' + name + '? This action cannot be undone.')) {
        window.location.href = '/admin/staff/' + id + '/delete';
    }
}
</script>
